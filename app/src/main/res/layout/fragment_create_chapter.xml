<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header: Chapter X -->

        <TextView
            android:id="@+id/tvChapterHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/blue"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp"
            android:text="New Chapter"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/ao3_rule" />

        <!-- Chapter Title -->
        <TextView
            style="@style/FieldLabel"
            android:layout_marginLeft="5dp"
            android:textSize="18sp"
            android:text="Chapter Title" />
        <EditText
            android:id="@+id/etChapterTitle"
            style="@style/EditText"
            android:layout_marginRight="5dp"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="5dp"/>

        <!-- Chapter Summary checkbox + field -->
        <CheckBox
            android:id="@+id/cbAddSummary"
            style="@style/CheckBox"
            android:text="Add chapter summary"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/etChapterSummary"
            style="@style/EditText"
            android:hint="Chapter summary"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:gravity="top"
            android:visibility="gone" />

        <!-- Notes above checkbox + field -->
        <CheckBox
            android:id="@+id/cbNotesAbove"
            style="@style/CheckBox"
            android:text="Add notes at the beginning" />

        <EditText
            android:id="@+id/etNotesAbove"
            style="@style/EditText"
            android:hint="Notes before the chapter text"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:gravity="top"
            android:visibility="gone" />

        <!-- Notes below checkbox + field -->
        <CheckBox
            android:id="@+id/cbNotesBelow"
            style="@style/CheckBox"
            android:text="Add notes at the end" />

        <EditText
            android:id="@+id/etNotesBelow"
            style="@style/EditText"
            android:hint="Notes after the chapter text"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:gravity="top"
            android:visibility="gone" />

        <!-- Chapter Content -->
        <TextView
            style="@style/FieldLabel"
            android:textSize="18sp"
            android:layout_marginLeft="5dp"
            android:text="Content" />
        <EditText
            android:id="@+id/etChapterContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:textSize="16sp"
            android:padding="12dp"
            android:background="@drawable/edit_text_border"
            android:minHeight="200dp"
            android:layout_marginBottom="16dp"
            android:layout_marginRight="5dp"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="5dp"/>

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:padding="16dp">

            <Button
                android:id="@+id/btnPublish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Post Chapter"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/ao3_title" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>