<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ══════════════════════════════════════
             PAGE TITLE
             ══════════════════════════════════════ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Post New Work"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:background="@color/ao3_header_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/ao3_rule" />

        <!-- ══════════════════════════════════════
             SECTION: TAGS  (required)
             ══════════════════════════════════════ -->

        <!-- Section header is a reusable include — see note below;
             if you'd rather inline it, replace with the TextView below -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tags"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:background="@color/ao3_stats_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/ao3_rule" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="4dp">

            <!-- Rating * -->
            <TextView
                style="@style/FieldLabel"
                android:text="Rating *" />
            <TextView
                style="@style/FieldHint"
                android:text="Choose the highest rating that applies to your work." />
            <Spinner
                android:id="@+id/spinnerRating"
                style="@style/Spinner" />

            <!-- Archive Warnings * -->
            <TextView
                style="@style/FieldLabel"
                android:text="Archive Warnings *" />
            <TextView
                style="@style/FieldHint"
                android:text="Check all that apply, or choose 'Creator Chose Not To Use Archive Warnings'." />

            <!-- Warning checkboxes -->
            <CheckBox android:id="@+id/cbWarnViolence"
                style="@style/CheckBox"
                android:text="Graphic Depictions of Violence" />
            <CheckBox android:id="@+id/cbWarnDeath"
                style="@style/CheckBox"
                android:text="Major Character Death" />
            <CheckBox android:id="@+id/cbWarnUnderage"
                style="@style/CheckBox"
                android:text="Underage" />
            <CheckBox android:id="@+id/cbWarnNonCon"
                style="@style/CheckBox"
                android:text="Non-Con" />
            <CheckBox android:id="@+id/cbWarnNoWarnings"
                style="@style/CheckBox"
                android:text="Creator Chose Not To Use Archive Warnings" />
            <CheckBox android:id="@+id/cbWarnNone"
                style="@style/CheckBox"
                android:text="No Archive Warnings Apply"
                android:layout_marginBottom="12dp" />

            <!-- Category -->
            <TextView
                style="@style/FieldLabel"
                android:text="Categories" />
            <TextView
                style="@style/FieldHint"
                android:text="Choose all categories that apply." />

            <CheckBox android:id="@+id/cbCatFF"  style="@style/CheckBox" android:text="F/F" />
            <CheckBox android:id="@+id/cbCatFM"  style="@style/CheckBox" android:text="F/M" />
            <CheckBox android:id="@+id/cbCatGen" style="@style/CheckBox" android:text="Gen" />
            <CheckBox android:id="@+id/cbCatMM"  style="@style/CheckBox" android:text="M/M" />
            <CheckBox android:id="@+id/cbCatMulti" style="@style/CheckBox" android:text="Multi" />
            <CheckBox android:id="@+id/cbCatOther" style="@style/CheckBox"
                android:text="Other"
                android:layout_marginBottom="12dp" />

            <!-- Fandoms * -->
            <TextView
                style="@style/FieldLabel"
                android:text="Fandoms *" />
            <TextView
                style="@style/FieldHint"
                android:text="Start typing to search. Select a suggestion or press Enter to add." />
            <AutoCompleteTextView
                android:id="@+id/actvFandoms"
                style="@style/EditText"
                android:hint="e.g. Naruto, Marvel" />

            <!-- Chip row for selected fandoms -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFandoms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp" />

            <!-- Relationships -->
            <TextView style="@style/FieldLabel" android:text="Relationships" />
            <TextView style="@style/FieldHint" android:text="Separate tags with Enter." />
            <include
                android:id="@+id/tagRelationships"
                layout="@layout/tag_input_with_chips" />

            <!-- Characters -->
            <TextView style="@style/FieldLabel" android:text="Characters" />
            <include
                android:id="@+id/tagCharacters"
                layout="@layout/tag_input_with_chips" />

            <!-- Additional Tags -->
            <TextView style="@style/FieldLabel" android:text="Additional Tags" />
            <include
                android:id="@+id/tagFreeforms"
                layout="@layout/tag_input_with_chips" />

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/ao3_rule" android:layout_marginTop="8dp" />

        <!-- ══════════════════════════════════════
             SECTION: PREFACE
             ══════════════════════════════════════ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preface"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:background="@color/ao3_stats_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/ao3_rule" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="4dp">

            <!-- Work Title * -->
            <TextView
                style="@style/FieldLabel"
                android:text="Work Title *" />
            <EditText
                android:id="@+id/etTitle"
                style="@style/EditText"
                android:hint="Title of your work" />

            <!-- Summary -->
            <TextView
                style="@style/FieldLabel"
                android:text="Summary" />
            <TextView
                style="@style/FieldHint"
                android:text="A short description — like a book jacket blurb." />
            <com.example.water.PasteableEditText
                android:id="@+id/etDescription"
                style="@style/EditText"
                android:inputType="textMultiLine"
                android:minLines="4"
                android:gravity="top"
                android:hint="What's your story about?" />

            <!-- Notes (optional) -->
            <TextView
                style="@style/FieldLabel"
                android:text="Notes" />
            <TextView
                style="@style/FieldHint"
                android:text="Displayed before the first chapter." />
            <EditText
                android:id="@+id/etNotes"
                style="@style/EditText"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:gravity="top"
                android:hint="Author's notes, acknowledgements, etc." />

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/ao3_rule" android:layout_marginTop="8dp" />

        <!-- ══════════════════════════════════════
             SECTION: ASSOCIATIONS
             ══════════════════════════════════════ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Associations"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:background="@color/ao3_stats_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/ao3_rule" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="4dp">

            <!-- Language * -->
            <TextView
                style="@style/FieldLabel"
                android:text="Language *" />
            <Spinner
                android:id="@+id/spinnerLanguage"
                style="@style/Spinner" />

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/ao3_rule" android:layout_marginTop="8dp" />

        <!-- ══════════════════════════════════════
             SECTION: PRIVACY
             ══════════════════════════════════════ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Privacy"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:background="@color/ao3_stats_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/ao3_rule" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">

            <CheckBox
                android:id="@+id/cbAnonymous"
                style="@style/CheckBox"
                android:text="Post anonymously" />

            <CheckBox
                android:id="@+id/cbCommentsDisabled"
                style="@style/CheckBox"
                android:text="Disable comments"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/ao3_rule" android:layout_marginTop="4dp" />

        <!-- ══════════════════════════════════════
             ACTION BUTTONS  (Preview + Post)
             ══════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp"
            android:gravity="end">

            <Button
                android:id="@+id/btnSaveDraft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save Draft"
                android:textColor="@color/ao3_title"
                android:backgroundTint="@android:color/transparent"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next: Add Chapter →"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/ao3_title" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>